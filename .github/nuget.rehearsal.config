<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only by the publish rehearsal in .github/workflows/release.yml, and never automatically:
  NuGet loads a file named nuget.config, and this one is named differently, so no restore in this
  repository can pick it up by accident.

  The rehearsal restores the packages it just pushed the way a consumer would, which needs both
  feeds: this SDK's packages are on GitHub Packages, everything they depend on
  (Microsoft.Extensions.*) is still on nuget.org. packageSourceMapping keeps them apart, so a slow
  or failing answer from one feed cannot break a restore of packages that live on the other - the
  situation GitHub's own NuGet registry documentation warns about.

  GITHUB_REPOSITORY_OWNER is an environment variable that NuGet substitutes when it reads the
  file, on every platform. Credentials stay out of this file: the workflow copies it to its
  temporary consumer directory and adds the short-lived token to that disposable copy.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/%GITHUB_REPOSITORY_OWNER%/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="TypeSafeAI.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
