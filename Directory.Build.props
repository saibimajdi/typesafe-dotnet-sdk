<Project>

  <!--
    Repository-wide build settings. Anything specific to shipping packages lives in
    src/Directory.Build.props; anything specific to tests lives in tests/Directory.Build.props.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Treat the compiler and the .NET analyzers as part of the test suite. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      Reproducible restores. Every project commits a packages.lock.json next to its project file,
      which pins the entire transitive graph: Central Package Management pins the versions this
      repository names, but a transitive dependency resolved through a range can still move.
      CI restores in locked mode (RestoreLockedMode follows CI, exactly like
      ContinuousIntegrationBuild above), so a change to Directory.Packages.props that was not
      accompanied by a regenerated lock file fails the build instead of quietly restoring a
      different graph than the one that was reviewed.

      Regenerate after a deliberate dependency change, with the force-evaluate option of
      `dotnet restore TypeSafe.slnx` (see CONTRIBUTING.md).

      Locked mode also means a new project must be restored once locally before it can be built
      in CI: it has no lock file until someone runs restore.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    Central Package Management is driven by Directory.Packages.props.
    MinVer derives the package version from the nearest git tag, so the version is never
    hand-edited and two commits can never disagree about it.
  -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerVerbosity>normal</MinVerVerbosity>
  </PropertyGroup>

</Project>
